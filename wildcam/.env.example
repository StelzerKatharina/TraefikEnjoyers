# Copy to .env and adjust. .env is git-ignored.

# Password for the bundled PostgreSQL container (use URL-safe characters: letters, digits, - _ .).
POSTGRES_PASSWORD=change-me

# Optional: point both apps at the central DB VM instead of the bundled container.
# DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DBNAME

# Optional: host port Traefik listens on (default 80).
# HTTP_PORT=80

# Optional: image tag to pull (default latest), e.g. a commit SHA for a pinned rollout.
# IMAGE_TAG=latest
